{
  "name": "field-forms-demo-server",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "serve:https": "set NODE_ENV=production&& ts-node-dev --respawn --transpile-only src/server-https.ts",
    "serve:http": "ts-node-dev --respawn --transpile-only src/start-http.ts"
  },
  "dependencies": {
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "http-proxy-middleware": "^3.0.5",
    "nodemon": "^3.1.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  },
  "version": "1.0.0",
