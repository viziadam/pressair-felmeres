{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    "jsx": "react-jsx",                // ← EZ KELL a TSX-hez
    "types": ["vite/client"]           // Vite típusok a frontendhez
  },
  "include": ["src/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "server"]  // ← külön szerver TS-t ne vegye bele
}